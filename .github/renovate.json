{
  "$schema": "http://json.schemastore.org/renovate",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "disabled",
  "timezone": "Europe/Warsaw",
  "schedule": [
    "before 9am on monday"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^bin/docker-setup\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\n[A-Z_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Merge non-major updates once the required checks pass; major updates need review.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchManagers": ["custom.regex"],
      "automerge": false
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["coursier/coursier"],
      "extractVersion": "^v(?<version>\\d+\\.\\d+\\.\\d+)$"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["bazelisk", "bazel-module"],
      "groupName": "Bazel"
    },
    {
      "description": "Update the Docker image's base image and build tools together.",
      "matchFileNames": ["Dockerfile", "bin/docker-setup.sh"],
      "groupName": "Docker image"
    },
    {
      "matchDatasources": ["gradle-version"],
      "matchPackageNames": ["gradle", "gradle/gradle"],
      "groupName": "Gradle runtime",
      "automerge": false
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["eclipse-temurin"],
      "allowedVersions": "/^25(?:[.-]|$)/",
      "automerge": false
    },
    {
      "description": "Keep the shared Kotlin toolchain version on stable releases, not IntelliJ-specific builds from the Analysis API repository, and update the libraries and Gradle plugin that share it in one PR.",
      "matchPackageNames": [
        "org.jetbrains.kotlin:*",
        "org.jetbrains.kotlin.jvm:org.jetbrains.kotlin.jvm.gradle.plugin"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "groupName": "Kotlin"
    },
    {
      "description": "Kotlin feature releases need review, since the Analysis API pin below moves with the toolchain by hand.",
      "matchPackageNames": [
        "org.jetbrains.kotlin:*",
        "org.jetbrains.kotlin.jvm:org.jetbrains.kotlin.jvm.gradle.plugin"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "The Analysis API engine pin is managed manually: it lives in the JetBrains intellij-dependencies repository, uses IDE-aligned version schemes, and must move in lockstep with the `kotlin` toolchain version.",
      "matchPackageNames": [
        "org.jetbrains.kotlin:kotlin-compiler",
        "*-for-ide",
        "com.intellij.platform:*"
      ],
      "enabled": false
    }
  ]
}
